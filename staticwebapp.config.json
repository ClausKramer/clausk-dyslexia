{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/src/*", "/styles.css"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Cache-Control": "public, max-age=300"
  },
  "mimeTypes": {
    ".js": "text/javascript; charset=utf-8",
    ".md": "text/markdown; charset=utf-8"
  }
}
